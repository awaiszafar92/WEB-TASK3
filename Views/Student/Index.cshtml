@model List<AttendanceManagementSystem.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<h1>Student Attendance Management</h1>

<p>
    <a asp-controller="Student"
       asp-action="Create"
       class="btn btn-primary">
        Add New Student
    </a>
</p>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Student ID</th>
            <th>Student Name</th>
            <th>Registration Number</th>
            <th>Department</th>
            <th>Attendance Percentage</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var student in Model)
        {
            <tr>

                <td>
                    @student.StudentID
                </td>

                <td>
                    @student.StudentName
                </td>

                <td>
                    @student.RegistrationNumber
                </td>

                <td>
                    @student.Department
                </td>

                <td>
                    @student.AttendancePercentage%
                </td>

                <td>

                    <a asp-controller="Student"
                       asp-action="Edit"
                       asp-route-id="@student.StudentID"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <form asp-controller="Student"
                          asp-action="Delete"
                          asp-route-id="@student.StudentID"
                          method="post"
                          style="display:inline;">

                        <button type="submit"
                                class="btn btn-danger"
                                onclick="return confirm('Are you sure you want to delete this student?');">
                            Delete
                        </button>

                    </form>

                </td>

            </tr>
        }

    </tbody>

</table>