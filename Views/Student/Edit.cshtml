@model AttendanceManagementSystem.Models.Student

@{
    ViewData["Title"] = "Edit Student";
}

<h1>Edit Student</h1>

<form asp-controller="Student"
      asp-action="Edit"
      method="post">

    <!-- Student ID -->
    <input type="hidden"
           asp-for="StudentID" />


    <div class="mb-3">
        <label asp-for="StudentName"
               class="form-label">
            Student Name
        </label>

        <input asp-for="StudentName"
               class="form-control" />

        <span asp-validation-for="StudentName"
              class="text-danger">
        </span>
    </div>


    <div class="mb-3">
        <label asp-for="RegistrationNumber"
               class="form-label">
            Registration Number
        </label>

        <input asp-for="RegistrationNumber"
               class="form-control" />

        <span asp-validation-for="RegistrationNumber"
              class="text-danger">
        </span>
    </div>


    <div class="mb-3">
        <label asp-for="Department"
               class="form-label">
            Department
        </label>

        <input asp-for="Department"
               class="form-control" />

        <span asp-validation-for="Department"
              class="text-danger">
        </span>
    </div>


    <div class="mb-3">
        <label asp-for="AttendancePercentage"
               class="form-label">
            Attendance Percentage
        </label>

        <input asp-for="AttendancePercentage"
               type="number"
               step="0.01"
               class="form-control" />

        <span asp-validation-for="AttendancePercentage"
              class="text-danger">
        </span>
    </div>


    <button type="submit"
            class="btn btn-primary">
        Update Student
    </button>

    <a asp-controller="Student"
       asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>